{
  "name": "arte-de-amar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gerar-imagens.mjs && node scripts/gerar-grao.mjs && vite",
    "build": "node scripts/gerar-imagens.mjs && node scripts/gerar-grao.mjs && node scripts/gerar-og.mjs && tsc --noEmit && tsc -p functions && vite build",
    "preview": "vite preview",
    "imagens": "node scripts/gerar-imagens.mjs --forcar",
    "dev:api": "npm run build && wrangler pages dev dist",
    "db:local": "wrangler d1 migrations apply arte-de-amar --local",
    "db:remoto": "wrangler d1 migrations apply arte-de-amar --remote",
    "admin": "node scripts/criar-admin.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.157.0"
  }
}
